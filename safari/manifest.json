{
  "manifest_version": 2,
  "name": "XPip",
  "description": "Picture-in-Picture that dodges your mouse cursor system-wide",
  "version": "1.4",
  "permissions": ["activeTab", "tabs", "<all_urls>", "http://127.0.0.1/*"],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XPip",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["shared/browser-env.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/browser-env.js",
        "shared/runtime-fetch.js",
        "shared/video-pip.js",
        "autopip.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
